---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descripcion?: string;
  imagen?: string;
  tipo?: 'website' | 'article';
  fechaPublicacion?: string;
}

const {
  titulo,
  descripcion = 'Noticias y campañas de marketing.',
  imagen,
  tipo = 'website',
  fechaPublicacion,
} = Astro.props;

const tituloCompleto = `${titulo} · Vidriera`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imagenAbsoluta = imagen ? new URL(imagen, Astro.site).href : undefined;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#0f1115" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Vidriera" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{tituloCompleto}</title>

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content="Vidriera" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonicalURL} />
    {imagenAbsoluta && <meta property="og:image" content={imagenAbsoluta} />}
    {tipo === 'article' && fechaPublicacion && (
      <meta property="article:published_time" content={fechaPublicacion} />
    )}

    <meta name="twitter:card" content={imagenAbsoluta ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    {imagenAbsoluta && <meta name="twitter:image" content={imagenAbsoluta} />}
  </head>
  <body class="font-texto text-marfil bg-fondo min-h-screen flex flex-col">
    <Header />
    <slot name="full-bleed" />
    <main class="flex-1 w-full max-w-5xl mx-auto px-4 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
