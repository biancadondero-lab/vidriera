---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = 'Noticias y campañas de marketing.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcion} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{titulo} · Vidriera</title>
  </head>
  <body class="font-texto text-tinta bg-papel min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full max-w-5xl mx-auto px-4 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
