---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { obtenerPublicadosOrdenados, filtrarPorCategoria, type Articulo } from '../lib/articles';

const entradas = await getCollection('articulos');
const articulos: Articulo[] = entradas.map((e) => ({ id: e.id, ...e.data }));

const publicados = obtenerPublicadosOrdenados(articulos);
const destacadosActuales = filtrarPorCategoria(publicados, 'campanas-actuales').slice(0, 3);
const destacadosDatos = filtrarPorCategoria(publicados, 'tendencias-y-datos').slice(0, 3);
---
<BaseLayout titulo="Inicio">
  {destacadosActuales.length > 0 && (
    <section class="mb-14">
      <h2 class="font-display text-2xl font-bold mb-4">Campañas actuales</h2>
      {destacadosActuales.map((a) => <ArticleCard articulo={a} />)}
    </section>
  )}
  {destacadosDatos.length > 0 && (
    <section class="mb-14">
      <h2 class="font-display text-2xl font-bold mb-4">Tendencias y datos</h2>
      {destacadosDatos.map((a) => <ArticleCard articulo={a} />)}
    </section>
  )}
  <section>
    <h2 class="font-display text-2xl font-bold mb-4">Todas las novedades</h2>
    {publicados.length > 0 ? (
      publicados.map((a) => <ArticleCard articulo={a} />)
    ) : (
      <p class="text-tinta/60">Todavía no hay artículos publicados.</p>
    )}
  </section>
</BaseLayout>
