---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout titulo="Página no encontrada" descripcion="La página que buscás no existe o se movió de lugar.">
  <div class="banda-404 relative mx-auto max-w-2xl overflow-hidden rounded-xl border border-borde px-6 py-16 text-center sm:px-10">
    <span class="relative block text-xs font-semibold uppercase tracking-wide text-acento">Error 404</span>
    <h1 class="relative mt-2 font-display text-4xl font-bold sm:text-5xl">Esta vitrina está vacía</h1>
    <p class="relative mx-auto mt-4 max-w-md text-sm text-marfil/70">
      La página que buscás no existe o se movió de lugar. Puede que el enlace esté roto o que la nota haya cambiado de nombre.
    </p>
    <a
      href="/"
      class="relative mt-8 inline-block rounded-lg border border-acento px-6 py-3 text-sm font-semibold text-acento transition-colors hover:bg-acento hover:text-fondo"
    >
      Volver al inicio
    </a>
  </div>
</BaseLayout>

<style>
  .banda-404 {
    background:
      radial-gradient(420px 220px at 15% 20%, color-mix(in srgb, var(--color-acento) 22%, transparent), transparent 60%),
      radial-gradient(360px 200px at 90% 90%, color-mix(in srgb, var(--color-acento) 14%, transparent), transparent 60%),
      var(--color-tarjeta);
  }
</style>
