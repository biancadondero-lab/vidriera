---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { obtenerPublicadosOrdenados, filtrarPorCategoria, type Articulo } from '../../lib/articles';
import { CATEGORIAS, nombreCategoria } from '../../lib/categorias';

export async function getStaticPaths() {
  return CATEGORIAS.map((c) => ({ params: { categoria: c.slug } }));
}

const { categoria } = Astro.params as { categoria: string };
const entradas = await getCollection('articulos');
const articulos: Articulo[] = entradas.map((e) => ({ id: e.id, ...e.data }));
const publicados = obtenerPublicadosOrdenados(articulos);
const deLaCategoria = filtrarPorCategoria(publicados, categoria);
---
<BaseLayout titulo={nombreCategoria(categoria)}>
  <h1 class="font-display text-3xl font-bold mb-8">{nombreCategoria(categoria)}</h1>
  {deLaCategoria.length === 0 ? (
    <p class="text-tinta/60">Todavía no hay artículos publicados en esta categoría.</p>
  ) : (
    deLaCategoria.map((a) => <ArticleCard articulo={a} />)
  )}
</BaseLayout>
